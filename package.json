{
  "name": "ashgrave-files",
  "version": "2.0.0",
  "private": true,
  "description": "THE ASHGRAVE FILES - a browser noir detective board game for 1-6 players.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "voices": "node tools/render-voices.mjs",
    "deploy": "npm run build && npx gh-pages -d dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
